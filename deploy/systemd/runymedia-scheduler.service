[Unit]
Description=RunyMediaMonitor scheduler (php artisan schedule:work)
After=network-online.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/runymedia
Environment=PHP_INI_SCAN_DIR=:/opt/runymedia/php/conf.d
ExecStart=/usr/bin/php8.5 artisan schedule:work
Restart=always
RestartSec=5
Nice=10
CPUQuota=50%
MemoryMax=256M
UMask=0027

[Install]
WantedBy=multi-user.target
