[Unit]
Description=RunyMediaMonitor PHP-FPM (dedicated pool, socket /run/runymedia/fpm.sock)
After=network.target

[Service]
Type=simple
RuntimeDirectory=runymedia
RuntimeDirectoryMode=0755
Environment=PHP_INI_SCAN_DIR=:/opt/runymedia/php/conf.d
ExecStart=/usr/sbin/php-fpm8.5 --nodaemonize --fpm-config /opt/runymedia/php/fpm.conf
ExecReload=/bin/kill -USR2 $MAINPID
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
