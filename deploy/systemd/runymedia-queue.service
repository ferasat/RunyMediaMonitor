[Unit]
Description=RunyMediaMonitor queue worker (checks, downloads, Bale delivery)
After=network-online.target
Wants=network-online.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/runymedia
Environment=PHP_INI_SCAN_DIR=:/opt/runymedia/php/conf.d
ExecStart=/usr/bin/php8.5 artisan queue:work --sleep=3 --tries=1 --timeout=1900 --max-time=3600
Restart=always
RestartSec=5
Nice=5
UMask=0027

[Install]
WantedBy=multi-user.target
